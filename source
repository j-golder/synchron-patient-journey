function DeliverySystemFlowchart({ onBack }: { onBack: () => void }) {
  const [activeStep, setActiveStep] = useState<{
    section: StepSection;
    step: string;
  } | null>(null);

  return (
    <div className="space-y-6 font-sans">
      <Button
        onClick={onBack}
        size="sm"
        className="gap-1 rounded-full px-4 py-3 mt-2 bg-[#00391E] text-white hover:bg-white hover:text-[#00391E] border border-[#00391E] transition-colors duration-200"
      >
        <ArrowLeft size={16} /> Back
      </Button>

      <Card className="p-4 md:p-6 lg:p-8 shadow-lg">
        <div className="space-y-2 text-center mb-6">
          <h2 className="text-2xl md:text-3xl font-bold" style={{ color: brand.primary }}>
            How Does Synchron's BCI Delivery System Work?
          </h2>
          <p className="text-gray-600">Click any step to learn more</p>
        </div>

        <div className="overflow-x-auto pb-4">
          <div className="flex items-start gap-6 min-w-[900px]">
            {stepSections.map((section, secIdx) => {
              const Icon = sectionIcons[section.title] || fallbackIcon;
              return (
                <React.Fragment key={section.id}>
                  <div className="flex flex-col items-center gap-3">
                    <Icon className="text-gray-500 mb-1" />
                    <h3 className="font-semibold" style={{ color: brand.primary }}>
                      {section.title}
                    </h3>
                    <div className="flex flex-col gap-2">
                      {section.steps.map((step, stepIdx) => (
                        <motion.div whileTap={{ scale: 0.96 }} key={step}>
                          <Button
                            size="sm"
                            variant="outline"
                            className="whitespace-nowrap border-gray-300 hover:bg-gray-50 font-sans rounded-full px-4"
                            style={{
                              borderColor:
                                activeStep?.section.id === section.id && activeStep.step === step
                                  ? brand.accent
                                  : "#ccc",
                              backgroundColor:
                                activeStep?.section.id === section.id && activeStep.step === step
                                  ? section.color
                                  : "white",
                              color: "black",
                            }}
                            onClick={() => setActiveStep({ section, step })}
                          >
                            <span className="mr-1 font-mono text-xs text-gray-600">
                              {stepSections
                                .slice(0, secIdx)
                                .reduce((acc, s) => acc + s.steps.length, 0) + stepIdx + 1}.
                            </span>
                            {step}
                          </Button>
                        </motion.div>
                      ))}
                    </div>
                  </div>

                  {secIdx !== stepSections.length - 1 && (
                    <div className="my-2 flex items-center justify-center">
                      <ArrowRight className="text-gray-400" />
                    </div>
                  )}
                </React.Fragment>
              );
            })}
          </div>
        </div>

        <AnimatePresence mode="wait">
          <motion.div
            key={activeStep ? activeStep.step : "placeholder"}
            initial={{ opacity: 0, y: 8 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: 8 }}
          >
            {activeStep ? (
              <Card
                className="p-5 bg-gray-50 border-l-4 mt-4"
                style={{ borderColor: activeStep.section.color }}
              >
                <div className="flex gap-3">
                  <Info className="mt-1 text-gray-500 shrink-0" />
                  <CardContent className="p-0 space-y-1">
                    <h4 className="font-bold" style={{ color: brand.primary }}>
                      {activeStep.step}
                    </h4>
                    <p>{stepDescriptions[activeStep.section.title][activeStep.step]}</p>

                    {stepDescriptions[activeStep.section.title][`${activeStep.step}_risk`] && (
                      <div className="mt-3">
                        <strong className="text-red-600">⚠ Possible Risk:</strong>
                        <p className="text-sm text-red-700 mt-1">
                          {stepDescriptions[activeStep.section.title][`${activeStep.step}_risk`]}
                        </p>
                      </div>
                    )}
                  </CardContent>
                </div>
              </Card>
            ) : (
              <p className="text-center text-sm text-gray-500 mt-4">
                Select a step to view details.
              </p>
            )}
          </motion.div>
        </AnimatePresence>
      </Card>

      <p className="text-xs text-center text-gray-500 max-w-lg mx-auto pt-6">
        This page was created independently as a fun community concept. No official Synchron endorsement was received, no budget was provided, and no office snacks were consumed in the making of it.
        <br /><br />
        Built by <a href="https://www.vitaely.me/jonahgolder" target="_blank" rel="noopener noreferrer" className="underline text-[#00391E]">Jonah Golder</a><br />
        Connect with me on <a href="https://www.linkedin.com/in/jonahgolder/" target="_blank" rel="noopener noreferrer" className="underline text-[#00391E]">LinkedIn</a>.
      </p>
    </div>
  );
}
